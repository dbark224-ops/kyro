{
  "name": "kyro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @kyro/web run dev --",
    "build": "npm --workspace @kyro/web run build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "env:check": "node scripts/check-env.mjs",
    "env:check:production": "node scripts/check-env.mjs --production",
    "lint": "npm run lint --workspaces --if-present",
    "lint:db": "node --test scripts/check-db-columns.test.mjs && node scripts/check-db-columns.mjs",
    "db:snapshot": "node scripts/refresh-schema-snapshot.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "prettier": "latest",
    "tsx": "^4.21.0",
    "typescript": "latest"
  }
}
